{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Inter))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioWaveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:voice|meta|bars|playing|style|key|ref|className|style|children)$/]",
        "message": "<AudioWaveform> doesn't accept that prop. Declared props: voice, meta, bars, playing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|dark|success|error|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'dark' | 'success' | 'error' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|tertiary|onDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'tertiary' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:hoverable|padding|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: hoverable, padding, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:lg|xl|xxl)$/]",
        "message": "<Card> radius must be one of 'lg' | 'xl' | 'xxl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientOrbCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:orb|secondOrb|eyebrow|title|body|children|style|key|ref|className|style|children)$/]",
        "message": "<GradientOrbCard> doesn't accept that prop. Declared props: orb, secondOrb, eyebrow, title, body, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientOrbCard'] > JSXAttribute[name.name='orb'] > Literal[value!=/^(?:mint|peach|lavender|sky|rose)$/]",
        "message": "<GradientOrbCard> orb must be one of 'mint' | 'peach' | 'lavender' | 'sky' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientOrbCard'] > JSXAttribute[name.name='secondOrb'] > Literal[value!=/^(?:mint|peach|lavender|sky|rose)$/]",
        "message": "<GradientOrbCard> secondOrb must be one of 'mint' | 'peach' | 'lavender' | 'sky' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|error|hint|type|placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, error, hint, type, placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:plan|price|period|blurb|features|cta|featured|badge|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<PricingTier> doesn't accept that prop. Declared props: plan, price, period, blurb, features, cta, featured, badge, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|accent|initials|onPreview|divider|style|key|ref|className|style|children)$/]",
        "message": "<VoiceRow> doesn't accept that prop. Declared props: name, accent, initials, onPreview, divider, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
